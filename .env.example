RESEND_API_KEY=
LEAD_FROM_EMAIL="Oak & Linen <leads@oakandlinen.example>"
LEAD_TO_EMAIL=hello@oakandlinen.example
# Option B: any webhook (Zapier, Make, n8n, Google Apps Script, CRM)
LEAD_WEBHOOK_URL=
